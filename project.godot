; Engine configuration file.
; Lunar Tilt - Star Ball Duels
config_version=5

[application]

config/name="Lunar Tilt - Star Ball Duels"
config/description="Flick phenolic balls up a 4.99-degree tilted oak board and land them in star-shaped slots. Physics duel inspired by the viral Star Cluster Ball sport."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/core/game_state.gd"
Rules="*res://scripts/core/rules_engine.gd"
Settings="*res://scripts/core/settings.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
3d/default_gravity=9.81
3d/default_gravity_vector=Vector3(0, -1, 0)
3d/physics_engine="JoltPhysics"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/textures/vram_compression/import_etc2_astc=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[dotnet]

project/assembly_name="LunarTilt"